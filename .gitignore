# Upstream browser build output.
node_modules/
/dev.html

# Godot 4.3+ generated cache and build directories.
.godot/
/android/

# Imported translations generated from CSV files.
*.translation

# Godot .NET generated files.
.mono/
data_*/
mono_crash.*.json

# Godot Launcher code-editor configuration can contain local paths.
# Remove this rule if the team intentionally shares VS Code configuration.
.vscode/

# Local build output.
build/
builds/
/assets/abyssal/world-*.gz
/assets/abyssal/shaders-*.bin

# Local editor and assistant configuration.
/.agents/
/.claude/
/.codex/
/addons/godot_mcp/
*.csproj.old

# Godot 4.0 compatibility:
# Godot 4.0 may store sensitive credentials in export_presets.cfg.
# Uncomment this rule before using Godot 4.0.
#
# If the file is already tracked, remove it from Git's index while keeping
# the local file:
# git rm --cached -- export_presets.cfg
#
# Then commit the .gitignore change and staged removal.
# This does not remove earlier versions from Git history. Rotate any
# credentials that may already have been committed.
# export_presets.cfg

# Legacy or migrated-project compatibility:
# Uncomment these only when the project still generates them.
# .import/
# export.cfg
